#!/usr/bin/env python3
"""One pinned `codex exec` run, start to finish, and a line in the ledger.

The Codex lane of the routing matrix. Opulent tiers Claude work by picking an
agent; this is what it picks instead when the work should be judged by a model
that shares neither this vendor nor this conversation — implementation you want
decorrelated, and review of code Claude itself wrote.

This program blocks. That is the whole design: the run's lifetime is this
process's lifetime, so the architect backgrounds it with Bash's
`run_in_background` and the harness re-invokes the architect when it exits.
Nothing has to track a run that outlived its watcher, because no run does.

It arrived here from the orrery plugin, which spent 13,185 lines learning that
lesson the other way round. There, a wrapper subagent backgrounded the run and
polled a marker file — and a subagent's turn ends, so the harness handle and
the watcher died while codex kept going. That bought a run registry, claim
files, staleness and orphan detection, and a Stop hook to notice runs nobody
collected: all of it rebuilding, by hand, the completion notification the
harness already gives the main loop. Removing the wrapper removed the problem.

What is left is the part that was always real: the model, effort and sandbox
pins live in one argv builder, the ledger line records the argv actually
executed rather than the values this script meant to use, and every claim this
program makes about a run is one it verified — the diff comes from git, the
exit code from the process, the session id from codex's own log, and in review
mode every cited file:line is checked to exist before you read it.
"""
import argparse
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

LANES = ("sol", "terra")
SANDBOXES = ("read-only", "workspace-write")

# Defaults, and the only source of them. Orrery made these overridable from a
# JSON file, with a loader, a PATH shim, a telemetry field recording whether
# the load had failed, and a test asserting the loader's copy of the constants
# had not drifted from this one. No such file was ever written, so every run
# that plugin ever performed used the values below. --effort and --sandbox
# override a single run, which is the need the configuration layer was
# actually serving.
EFFORT = {"sol": "max", "terra": "xhigh", "review": "max"}
SANDBOX = {"sol": "workspace-write", "terra": "workspace-write",
           "review": "read-only"}
# review is a MODE, not a lane: it runs on sol's model, read-only. The model
# slug is "gpt-5.6-" + lane, so a "review" lane would name a model that does
# not exist.
MODEL_LANE = {"sol": "sol", "terra": "terra", "review": "sol"}

NETWORK = "sandbox_workspace_write.network_access=true"
GRACE = 10          # seconds between SIGTERM and SIGKILL on timeout
SID_SCAN = 1 << 20  # bytes of run log read looking for the session id

UUID = (r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}"
        r"-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
SID_RE = re.compile(r"session[\s._-]*id\b[^0-9a-fA-F]{0,8}(%s)" % UUID, re.I)

# A citation as codex writes one: a path with an extension, a colon, a line.
# Deliberately loose on the path and strict on the shape — a false candidate
# costs one stat() and gets reported as uncheckable, while a missed one is a
# claim nobody verified.
CITE_RE = re.compile(
    r"(?<![\w./+-])((?:\.{1,2}/|/)?[\w][\w./+-]*\.[A-Za-z0-9_+-]+):(\d+)\b")

FINDING_RE = re.compile(r"^\s*([\w][\w./+-]*\.[A-Za-z0-9_+-]+:\d+)\s*[—|-]+\s*"
                        r"([A-Za-z]+)\s*[—|-]+\s*(.+?)\s*$")


def log_path():
    return os.environ.get("OPULENT_CODEX_LOG") or os.path.join(
        os.path.expanduser("~"), ".claude", "opulent-codex.jsonl")


def append(record):
    """One ledger line, best effort. A run that happened and could not be
    logged is still a run: the failure goes to stderr and never to the exit
    code, because losing the work over losing the record helps nobody."""
    record["t"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    try:
        path = log_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "a", encoding="utf-8") as f:
            f.write(json.dumps(record, sort_keys=True) + "\n")
    except Exception as exc:                                  # noqa: BLE001
        print("opulent-codex: ledger write failed: %s" % exc, file=sys.stderr)


def codex_binary():
    name = os.environ.get("OPULENT_CODEX_BIN") or "codex"
    return shutil.which(name) or name


def build_argv(codex, lane, effort, sandbox, cwd, last, network=False):
    """The one argv builder. Every dispatch this plugin performs is this list.

    Verified against codex-cli 0.146.0 and again, end to end, against 0.149.1.
    The trailing `-` is the PROMPT
    positional: `codex exec` reads the prompt from stdin when it is `-`, which
    is how the brief gets in. `-o LAST` is where codex writes its final
    message, which is the only part of the run this program reads back."""
    argv = [codex, "exec",
            "-m", "gpt-5.6-" + MODEL_LANE[lane],
            "-c", "model_reasoning_effort=" + effort,
            "-s", sandbox,
            "-C", cwd,
            "--skip-git-repo-check",
            "--color", "never",
            "-o", last]
    if network:
        argv += ["-c", NETWORK]
    return argv + ["-"]


def git(cwd, *args):
    """-> stdout, or "" if git could not answer. Never raises: every caller is
    reporting on a run that already happened, and a missing git is a gap in
    the report rather than a reason to lose it."""
    try:
        p = subprocess.run(["git", "-C", cwd, *args], capture_output=True,
                           text=True, timeout=30)
        return p.stdout if p.returncode == 0 else ""
    except Exception:                                          # noqa: BLE001
        return ""


def worktree_state(cwd):
    """A set of the paths git currently considers changed, staged or not."""
    return {line[3:] for line in git(cwd, "status", "--porcelain=v1").splitlines()
            if len(line) > 3}


def session_id(runlog):
    """-> the session id codex printed, or None. Never constructed: a wrapper
    reporting an id nobody can resume is worse than one that says it could not
    find it."""
    try:
        with open(runlog, "rb") as f:
            head = f.read(SID_SCAN).decode("utf-8", "replace")
    except OSError:
        return None
    found = SID_RE.search(head)
    return found.group(1) if found else None


def default_range(cwd):
    """What to review when the caller named no range. A dirty tree is what the
    operator is working on, so it wins; otherwise it is this branch's own
    commits, measured from where it left the default branch."""
    if worktree_state(cwd):
        return None                      # working-tree diff, not a rev range
    head = git(cwd, "symbolic-ref", "--quiet", "refs/remotes/origin/HEAD").strip()
    base = head.rsplit("/", 1)[-1] if head else ""
    for candidate in (base, "main", "master"):
        if candidate and git(cwd, "rev-parse", "--verify", "--quiet",
                             candidate + "^{commit}").strip():
            merge = git(cwd, "merge-base", candidate, "HEAD").strip()
            if merge:
                return merge + "..HEAD"
    return None


def review_brief(cwd, rev_range):
    """The review brief, built here rather than written by a caller.

    Mechanism in code: the format the findings come back in is the format this
    program parses, so the two cannot drift the way a prompt and its reader
    do. Returns (text, description-of-what-was-diffed)."""
    if rev_range:
        diff = git(cwd, "diff", "--no-color", rev_range)
        what = rev_range
    else:
        diff = git(cwd, "diff", "--no-color", "HEAD")
        what = "the working tree against HEAD"
    if not diff.strip():
        return None, what
    return ("""You are reviewing a diff as a second witness: a different vendor's
model, with none of the author's conversation and none of their assumptions.
Report only defects you can point at in the diff — correctness bugs, missing
error handling, security problems, race conditions, resource leaks. Style
preferences and speculative refactors are out of scope.

Every finding MUST cite a real file and line from the diff. A finding you
cannot cite is one you should not report.

Return findings inside a fenced block marked `findings`, one per line, in
exactly this form:

```findings
path/to/file.py:42 — HIGH — the lock is released before the write completes
path/to/other.js:7 — LOW — err is shadowed and the outer one is never checked
```

Severity is one of HIGH, MEDIUM, LOW. If you find nothing, return an empty
findings block. Anything you want to say beyond the findings goes after the
block, in prose.

The diff under review (%s):

```diff
%s
```
""" % (what, diff), what)


def citations(text, cwd):
    """Every path:line in the text, checked against the tree.

    -> list of (citation, verdict). Verdicts: "ok", "no such line", "no such
    file", "outside the tree". Nothing is dropped: an unverifiable citation is
    reported as unverifiable, because silently removing a finding is the one
    outcome worse than showing a bad one."""
    out, seen = [], set()
    root = os.path.realpath(cwd)
    for path, line in CITE_RE.findall(text):
        key = "%s:%s" % (path, line)
        if key in seen:
            continue
        seen.add(key)
        full = os.path.realpath(os.path.join(cwd, path))
        if not (full == root or full.startswith(root + os.sep)):
            out.append((key, "outside the tree"))
            continue
        try:
            with open(full, "rb") as f:
                total = sum(1 for _ in f)
        except OSError:
            out.append((key, "no such file"))
            continue
        out.append((key, "ok" if 1 <= int(line) <= total else
                    "no such line (file has %d)" % total))
    return out


def run(argv, brief_text, runlog, timeout):
    """Run codex to completion, tee'ing its output to runlog. -> exit code."""
    with open(runlog, "wb") as sink:
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=sink,
                                stderr=subprocess.STDOUT)
        try:
            proc.communicate(brief_text.encode("utf-8"), timeout=timeout)
        except subprocess.TimeoutExpired:
            # SIGTERM, then SIGKILL if it will not go — what timeout(1) does,
            # so codex gets its chance to close the session cleanly.
            proc.send_signal(signal.SIGTERM)
            try:
                proc.communicate(timeout=GRACE)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.communicate()
            return 124
    return proc.returncode


def report(lane, exit_code, sid, touched, last_message, cites, paths):
    """The block the caller reads. Every line of it is measured, not claimed."""
    outcome = ("done" if exit_code == 0 else
               "timed out" if exit_code == 124 else "failed")
    print("\n=== codex %s: %s (exit %d) ===" % (lane, outcome, exit_code))
    if touched is None:
        print("files changed: not measured (read-only run)")
    elif touched:
        for p in sorted(touched):
            print("files changed: %s" % p)
    else:
        print("files changed: none — the diff is empty")
    if cites is not None:
        bad = [c for c in cites if c[1] != "ok"]
        print("citations: %d checked, %d unverifiable" % (len(cites), len(bad)))
        for key, verdict in cites:
            if verdict != "ok":
                print("  UNVERIFIABLE  %s — %s" % (key, verdict))
    print("session id: %s" % (sid or "not found in the run log"))
    for label, path in paths:
        print("%s: %s" % (label, path))
    print("--- codex's final message ---")
    print(last_message.rstrip() or "(empty)")


def parse(argv=None):
    ap = argparse.ArgumentParser(
        prog="opulent-codex", allow_abbrev=False,
        description="Run one pinned codex exec and report what it actually did.")
    ap.add_argument("lane", choices=sorted(set(LANES) | {"review"}))
    ap.add_argument("dir", help="absolute working directory codex runs in")
    ap.add_argument("brief", nargs="?",
                    help="path to the brief file; review builds its own")
    ap.add_argument("--range", dest="rev_range",
                    help="review only: the rev range to review")
    ap.add_argument("--effort", choices=("low", "medium", "high", "xhigh", "max"))
    ap.add_argument("--sandbox", choices=SANDBOXES)
    ap.add_argument("--network", action="store_true")
    ap.add_argument("--timeout", type=int, default=0,
                    help="seconds before the run is killed; 0 for none")
    ap.add_argument("--out", help="directory for this run's files")
    opts = ap.parse_args(argv)
    if opts.lane == "review" and opts.brief:
        ap.error("review builds its own brief — pass --range, not a brief file")
    if opts.lane != "review" and not opts.brief:
        ap.error("%s needs a brief file" % opts.lane)
    if not os.path.isabs(opts.dir):
        ap.error("dir must be absolute, got %r" % opts.dir)
    if not os.path.isdir(opts.dir):
        ap.error("no such directory: %s" % opts.dir)
    return opts


def main(argv=None):
    opts = parse(argv)
    lane = opts.lane
    effort = opts.effort or EFFORT[lane]
    sandbox = opts.sandbox or SANDBOX[lane]
    cwd = os.path.abspath(opts.dir)
    out = opts.out or tempfile.mkdtemp(prefix="opulent-codex-")
    os.makedirs(out, exist_ok=True)
    stem = os.path.join(out, "%s-%d" % (lane, os.getpid()))
    runlog, last = stem + ".log", stem + "-last.txt"

    if lane == "review":
        rev_range = opts.rev_range or default_range(cwd)
        brief_text, what = review_brief(cwd, rev_range)
        if brief_text is None:
            print("codex review: nothing to review — %s is empty" % what)
            return 0
        brief_path = stem + "-brief.md"
        with open(brief_path, "w", encoding="utf-8") as f:
            f.write(brief_text)
    else:
        brief_path = opts.brief
        try:
            with open(brief_path, encoding="utf-8") as f:
                brief_text = f.read()
        except OSError as exc:
            print("opulent-codex: cannot read brief %s: %s" % (brief_path, exc),
                  file=sys.stderr)
            return 1

    before = worktree_state(cwd) if sandbox != "read-only" else None
    codex = codex_binary()
    argv_run = build_argv(codex, lane, effort, sandbox, cwd, last, opts.network)
    record = {"event": "dispatch", "lane": lane,
              "model": "gpt-5.6-" + MODEL_LANE[lane], "effort": effort,
              "sandbox": sandbox, "cwd": cwd, "argv": argv_run}
    code = 1
    try:
        code = run(argv_run, brief_text, runlog, opts.timeout or None)
    finally:
        # In a finally block so a run that died mid-flight still leaves the
        # line proving it happened. The ledger's whole value is that it cannot
        # be quieter than reality.
        record["exit"] = code
        record["sid"] = session_id(runlog)
        append(record)

    try:
        with open(last, encoding="utf-8") as f:
            last_message = f.read()
    except OSError:
        last_message = ""
    touched = (None if before is None
               else worktree_state(cwd) - before)
    cites = citations(last_message, cwd) if lane == "review" else None
    report(lane, code, record["sid"], touched, last_message, cites,
           [("brief", brief_path), ("run log", runlog)])
    return code


if __name__ == "__main__":
    sys.exit(main())
